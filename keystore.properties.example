# Release signing for the Play upload key. NOT for version control.
#
# Uncomment all four lines and fill in the three secrets, then run:
#     gradlew bundleRelease
#
# Until every value is filled in, release builds come out UNSIGNED.
# Use forward slashes in storeFile, even on Windows.

#storeFile=C:/Users/comac/keystores/android.jks
#storePassword=
#keyAlias=
#keyPassword=
